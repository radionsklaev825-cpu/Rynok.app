name: Make signing key
on:
  workflow_dispatch:
permissions:
  contents: write
jobs:
  key:
    runs-on: ubuntu-22.04
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: "17"
      - name: Create encrypted key
        env:
          KEY_PASS: ${{ secrets.KEY_PASS }}
        run: |
          if [ -f signing/debug.keystore.enc ]; then echo "Key already exists"; exit 1; fi
          if [ -z "$KEY_PASS" ]; then echo "KEY_PASS is not set"; exit 1; fi
          mkdir -p signing
          keytool -genkeypair -keystore debug.keystore -storepass android -keypass android -alias androiddebugkey -keyalg RSA -keysize 2048 -validity 10000 -dname "CN=GoldBull,O=GoldBull,C=UZ"
          openssl enc -aes-256-cbc -pbkdf2 -iter 200000 -salt -in debug.keystore -out signing/debug.keystore.enc -pass env:KEY_PASS
          rm debug.keystore
          git config user.name "github-actions"
          git config user.email "actions@github.com"
          git add signing/debug.keystore.enc
          git commit -m "Add encrypted signing key"
          git push
